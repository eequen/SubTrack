{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://subtrack.local/schemas/flashcards_v1.json",
  "title": "SubTrack flashcards import, schema v1",
  "description": "The exact object SubTrack expects from the external AI prompt (docs/prompts/flashcards_v1.txt). Validation in the app also applies the documented length limits after trimming and rejects HTML tags.",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "subtrack.cards.v1"
    },
    "deck": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Optional in the parser: missing or blank becomes 'Imported cards'."
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "required": ["front", "back"],
        "additionalProperties": false,
        "properties": {
          "front": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "back": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "description": "Present instead of cards when the AI cannot read the attachment."
    }
  },
  "oneOf": [
    {
      "required": ["cards"]
    },
    {
      "required": ["error"]
    }
  ]
}
